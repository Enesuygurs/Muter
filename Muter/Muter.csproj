<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>Muter</RootNamespace>
    <AssemblyName>Muter</AssemblyName>
    <ApplicationIcon>Resources\muter.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
    <!-- Version and assembly attributes live in Properties\AssemblyInfo.cs. Keeping them there (instead of
         SDK-generated attributes) keeps the user.config folder name stable so saved settings survive upgrades. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Keep the exe at bin\<Configuration>\Muter.exe so existing "Run at startup" entries keep working. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\*.ico;Resources\*.png" LogicalName="Muter.Resources.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="UI\HotkeyForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="UI\HotkeyForm.Designer.cs">
      <DependentUpon>HotkeyForm.cs</DependentUpon>
    </Compile>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <Compile Update="Properties\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
    </Compile>
  </ItemGroup>

</Project>
